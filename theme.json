{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1180px"
    },
    "color": {
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "ink", "name": "Ink", "color": "#17201e" },
        { "slug": "muted", "name": "Muted", "color": "#69716c" },
        { "slug": "cream", "name": "Cream", "color": "#f7f5ef" },
        { "slug": "coral", "name": "Coral", "color": "#ff654f" },
        { "slug": "line", "name": "Line", "color": "#dfe2da" },
        { "slug": "mint", "name": "Mint", "color": "#80c6a6" },
        { "slug": "white", "name": "White", "color": "#ffffff" }
      ]
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": ["px", "rem", "em", "%", "vw", "vh"],
      "spacingSizes": [
        { "slug": "10", "size": "0.5rem", "name": "XS" },
        { "slug": "20", "size": "1rem", "name": "S" },
        { "slug": "30", "size": "1.5rem", "name": "M" },
        { "slug": "40", "size": "2rem", "name": "L" },
        { "slug": "50", "size": "3rem", "name": "XL" },
        { "slug": "60", "size": "5rem", "name": "2XL" },
        { "slug": "70", "size": "7rem", "name": "3XL" }
      ]
    },
    "typography": {
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Arial",
          "fontFamily": "Arial, Helvetica, sans-serif"
        },
        {
          "slug": "editorial",
          "name": "Georgia",
          "fontFamily": "Georgia, 'Times New Roman', serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.75rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.25rem", "name": "Large" },
        { "slug": "x-large", "size": "2rem", "name": "Extra Large" },
        { "slug": "display", "size": "clamp(3.25rem, 6vw, 4.375rem)", "name": "Display" }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|cream",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "0"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "16px",
      "lineHeight": "1.5"
    },
    "elements": {
      "button": {
        "color": {
          "background": "var:preset|color|coral",
          "text": "var:preset|color|white"
        },
        "border": {
          "radius": "5px"
        },
        "typography": {
          "fontSize": "13px",
          "fontWeight": "700"
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontWeight": "400",
          "lineHeight": "1.05"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|ink"
        }
      }
    },
    "blocks": {
      "core/button": {
        "spacing": {
          "padding": {
            "top": "16px",
            "right": "19px",
            "bottom": "16px",
            "left": "19px"
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "13px"
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
